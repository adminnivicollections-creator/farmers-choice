{
  "name": "farmers-choice",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose -f infra/docker/compose.yml up -d",
    "db:down": "docker compose -f infra/docker/compose.yml down",
    "api:dev": "npm -w @fc/api run dev",
    "test": "npm run build -w @fc/fert && npm run test --workspaces --if-present"
  },
  "overrides": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8"
  }
}
