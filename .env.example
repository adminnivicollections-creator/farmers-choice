# Copy to .env. Never commit the real file.
DATABASE_URL=postgresql://fc:fc@localhost:5433/farmers_choice
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP delivery. "console" prints the code to the API log (dev only).
# "msg91" requires DLT-registered templates -- see docs/architecture.md
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Google Maps (Android). Get one at console.cloud.google.com -> Credentials.
# MUST be restricted to the Android package + SHA-1 and to Maps SDK for Android;
# the key is embedded in the APK and is not a secret.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
